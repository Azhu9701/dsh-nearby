{
  "name": "dsh-nearby",
  "version": "0.6.3",
  "type": "module",
  "description": "邻座 NextSeat：同一 Wi-Fi 下的临时分享房间（文件 / 提示词卡片 / 技能包），带就近自动发现。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "guest.html",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "vendor/qrcode.cjs",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "screenshots.json",
    "assets/*.png",
    "assets/demo.gif"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Azhu9701/dsh-nearby"
  },
  "homepage": "https://github.com/Azhu9701/dsh-nearby#readme",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "file-sharing",
    "lan",
    "prompt-cards",
    "skills",
    "nearby"
  ]
}
